generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  password         String? // nullable for OAuth
  resetCode        String? // 6-digit code for password reset
  resetCodeExpires DateTime?
  stripeCustomerId String?  @unique
  credits          Int      @default(0)
  createdAt         DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile         Profile?
  resumes         Resume[]
  jobDescriptions JobDescription[]
  subscriptions   Subscription[]
  creditLedger    CreditLedger[]

  @@index([createdAt])
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  skills       Json
  experience   Json
  education    Json
  projects     Json
  achievements Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  personalInfo PersonalInformation?

  @@index([userId])
}

model PersonalInformation {
  id        String @id @default(uuid())
  profileId String @unique

  fullName  String?
  phone     String?
  location  String?
  linkedIn  String?
  email     String?
  portfolio String?
  jobTitle  String?
  pronouns  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model JobDescription {
  id         String   @id @default(uuid())
  userId     String
  content    String
  parsedData Json // consider Json? if you sometimes store before parsing
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resumes Resume[]

  @@index([userId, createdAt])
}

enum Template {
  abdul
  noah
  nisha
  habib
  parth
  ryan
  yao
}

model Resume {
  id               String  @id @default(uuid())
  userId           String
  jobDescriptionId String?

  title        String       @default("Untitled")
  status       ResumeStatus @default(processing)
  errorMessage String?
  content      Json?
  jdRaw        String?

  // just store which template enum was used (optional)
  template Template?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jobDescription JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, updatedAt])
  @@index([status, createdAt])
  @@index([jobDescriptionId])
}

enum ResumeStatus {
  processing
  ready
  failed
}


model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id])
  stripeSubscriptionId String   @unique
  status               String
  currentPeriodEnd     DateTime
  priceId              String
  productId            String

  @@index([userId])
}

model CreditLedger {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  delta                  Int
  reason                 String
  opKey                  String?  @unique       // ← idempotency key for spends/refunds
  stripePaymentIntentId  String?  @unique
  createdAt              DateTime @default(now())

  @@index([userId])
}


model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  createdAt     DateTime @default(now())
}